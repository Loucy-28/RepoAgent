# LLM Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=repo_agent
POSTGRES_PASSWORD=repo_agent_pass
POSTGRES_DB=repo_agent

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Docker Sandbox
SANDBOX_IMAGE=repo-agent-sandbox
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_TIMEOUT=30
SANDBOX_NETWORK=none

# Application
APP_ENV=development
LOG_LEVEL=INFO
MAX_AGENT_ITERATIONS=5
